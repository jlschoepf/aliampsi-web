// PostgreSQL. En serverless (Vercel) usá una conexión "pooled" en DATABASE_URL
// y una conexión directa en DIRECT_URL (para migraciones y prisma db push).
// Con Neon/Supabase ambas cadenas te las da el propio panel.
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Noticia {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @default("")
  content     String    @default("")
  coverImage  String?
  author      String    @default("")
  document    String?
  sourceUrl   String    @default("")
  seoTitle    String    @default("")
  seoDescription String @default("")
  featured    Boolean   @default(false)
  tags        String    @default("")
  gallery     String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Publicacion {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  body        String   @default("")
  author      String   @default("")
  document    String?
  sourceUrl   String   @default("")
  seoTitle    String    @default("")
  seoDescription String @default("")
  kind        String   @default("revista") // revista | documento | articulo
  linkUrl     String   @default("")
  coverImage  String?
  featured    Boolean   @default(false)
  tags        String    @default("")
  gallery     String    @default("")
  publishedAt DateTime?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Congreso {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  body        String    @default("")
  author      String    @default("")
  document    String?
  sourceUrl   String    @default("")
  seoTitle    String    @default("")
  seoDescription String @default("")
  location    String    @default("")
  startDate   DateTime?
  endDate     DateTime?
  linkUrl     String    @default("")
  coverImage  String?
  featured    Boolean   @default(false)
  tags        String    @default("")
  gallery     String    @default("")
  publishedAt DateTime?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Asociacion {
  id          String   @id @default(cuid())
  name        String
  acronym     String   @default("")
  country     String   @default("")
  website     String   @default("")
  logoImage   String?
  description String   @default("")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Autoridad {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  country   String   @default("")
  bio       String   @default("")
  photo     String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  eyebrow   String   @default("")
  title     String
  text      String   @default("")
  image     String?
  ctaLabel  String   @default("")
  ctaUrl    String   @default("")
  cta2Label String   @default("")
  cta2Url   String   @default("")
  overlay   String   @default("dark")
  textColor String   @default("light")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Indicador {
  id        String   @id @default(cuid())
  value     String
  label     String
  icon      String   @default("")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id           String   @id @default("singleton")
  contactEmail String   @default("info@aliampsi.com")
  whatsapp     String   @default("")
  instagram    String   @default("")
  facebook     String   @default("")
  youtube      String   @default("")
  linkedin     String   @default("")
  contactTitle String   @default("Sumate a la Alianza")
  contactText  String   @default("")
  footerText   String   @default("")
  qsTitle      String   @default("")
  qsIntro      String   @default("")
  qsMision     String   @default("")
  qsCompromiso String   @default("")
  qsPilar1Title String  @default("")
  qsPilar1Text  String  @default("")
  qsPilar2Title String  @default("")
  qsPilar2Text  String  @default("")
  qsPilar3Title String  @default("")
  qsPilar3Text  String  @default("")
  seoTitle       String  @default("")
  seoDescription String  @default("")
  seoImage       String  @default("")
  gscVerification String @default("")
  gaId           String  @default("")
  notifyEmail    String  @default("")
  notifyStatus   String  @default("")
  notifyAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Hito {
  id        String   @id @default(cuid())
  fecha     String
  texto     String   @default("")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        String   @id @default(cuid())
  label     String
  href      String   @default("")
  order     Int      @default(0)
  published Boolean  @default(true)
  newTab    Boolean  @default(false)
  cta       Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portada {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Envio {
  id           String   @id @default(cuid())
  tipo         String   @default("noticia")
  tipoOtro     String   @default("")
  title        String
  summary      String   @default("")
  body         String   @default("")
  orgName      String   @default("")
  contactName  String   @default("")
  contactEmail String   @default("")
  contactPhone String   @default("")
  linkUrl      String   @default("")
  location     String   @default("")
  eventDate    String   @default("")
  coverImage   String?
  document     String?
  status       String   @default("pendiente")
  adminNote    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
