// PostgreSQL. En serverless (Vercel) usá una conexión "pooled" en DATABASE_URL
// y una conexión directa en DIRECT_URL (para migraciones y prisma db push).
// Con Neon/Supabase ambas cadenas te las da el propio panel.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Noticia {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @default("")
  content     String    @default("")
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Publicacion {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  kind        String   @default("revista") // revista | documento | articulo
  linkUrl     String   @default("")
  coverImage  String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Congreso {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  location    String    @default("")
  startDate   DateTime?
  endDate     DateTime?
  linkUrl     String    @default("")
  coverImage  String?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Asociacion {
  id          String   @id @default(cuid())
  name        String
  acronym     String   @default("")
  country     String   @default("")
  website     String   @default("")
  logoImage   String?
  description String   @default("")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
